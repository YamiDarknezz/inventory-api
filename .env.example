# Execution profile: dev (H2 in-memory) or prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT — ALWAYS set a real secret in production
JWT_SECRET=dev-only-secret-key-change-me-0123456789abcdef
JWT_EXPIRATION_MS=86400000

